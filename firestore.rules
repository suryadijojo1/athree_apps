rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Connection Health Check
    match /test/{testDoc} {
      allow read, write: if true;
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true;
      allow write: if isValidId(productId);
    }

    // Transactions Collection
    match /transactions/{transactionId} {
      allow read: if true;
      allow write: if isValidId(transactionId);
    }

    // Cash Flow Records
    match /cashFlowRecords/{recordId} {
      allow read: if true;
      allow write: if isValidId(recordId);
    }

    // Cashier Shifts
    match /shifts/{shiftId} {
      allow read: if true;
      allow write: if isValidId(shiftId);
    }

    // Kaos Stocks Collection
    match /kaosStocks/{stockId} {
      allow read: if true;
      allow write: if isValidId(stockId);
    }

    // Stock Movements Collection
    match /stockMovements/{movementId} {
      allow read: if true;
      allow write: if isValidId(movementId);
    }

    // Customers Collection
    match /customers/{customerId} {
      allow read: if true;
      allow write: if isValidId(customerId);
    }

    // POS App Users Collection
    match /users/{userId} {
      allow read: if true;
      allow write: if isValidId(userId);
    }

    // Meta collection (sync status, heartbeat)
    match /meta/{metaDoc} {
      allow read: if true;
      allow write: if isValidId(metaDoc);
    }
  }
}
